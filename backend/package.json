{
  "name": "callingin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CallingIn Express backend",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "npm --prefix .. run lint:backend --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {}
}
