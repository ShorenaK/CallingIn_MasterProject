# Copy to backend/.env and fill in your private Atlas connection string.
# Backend npm start and npm run dev load .env automatically.
# Keep port 3001 to match the frontend development proxy.
PORT=3001

# Placeholders only: real credentials belong in ignored backend/.env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=callingin_dev

# Development uses plain HTTP on your computer. Production must use HTTPS:
# NODE_ENV=production makes session cookies Secure (HTTPS-only).
# A reverse proxy will also need explicit, trusted proxy configuration in code;
# changing this value alone does not configure HTTPS or proxy trust.
NODE_ENV=development

# Signs the session ID cookie so the server can detect tampering. This is not
# your MongoDB password, and it does not encrypt the contents of the database.
# Generate a private random value from the project root with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put the result ONLY in backend/.env or your deployment's secret settings.
# Never commit the generated value. Use a separate secret in each environment.
# Changing this secret invalidates cookies signed with the previous value.
# Leave this template empty: session setup rejects a missing or short secret.
SESSION_SECRET=

# Exact browser origin for the upcoming state-changing request protection:
# scheme + hostname + optional port, with no path or trailing slash.
# This matches frontend/vite.config.js. localhost and 127.0.0.1 are different
# origins; open the frontend at this address during development.
# In production, replace this with the public HTTPS frontend origin.
# This setting will be enforced when request-protection middleware is connected;
# it does not enable CORS, configure hosting, or protect requests on its own.
APP_ORIGIN=http://127.0.0.1:5173
