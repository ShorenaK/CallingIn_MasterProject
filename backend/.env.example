# Copy to backend/.env and fill in your private Atlas connection string.
# Backend npm start and npm run dev load .env automatically.
# Keep port 3001 to match the frontend development proxy.
PORT=3001

# Placeholders only: real credentials belong in ignored backend/.env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=callingin_dev
